# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# URL для подключения к Qdrant внутри сети Docker Compose
QDRANT_URL=http://qdrant:6333

# Модель эмбеддингов на OpenRouter
EMBED_MODEL=qwen/qwen3-embedding-8b

# Модели для OpenRouter (можно изменить на gemini, claude или др.)
MAIN_MODEL=deepseek/deepseek-v4-flash
REWRITE_MODEL=deepseek/deepseek-v4-flash

# Локальная модель реранкера
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# API ключ для транскрибации голоса (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Конфигурация LLM (OpenRouter / LM Studio / Ollama)
# Для локальной модели (например LM Studio) раскомментируй следующие строки:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=local
# Для Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local
# По умолчанию используется OpenRouter:
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_API_KEY=your_openrouter_api_key_here

# API ключ Jina для парсинга сайтов и поиска (jina.ai)
JINA_API_KEY=your_jina_api_key_here
