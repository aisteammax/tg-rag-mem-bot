# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# API-ключ OpenRouter (зарегистрироваться на openrouter.ai)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# URL для подключения к Qdrant внутри сети Docker Compose
QDRANT_URL=http://qdrant:6333

# Модель эмбеддингов на OpenRouter
EMBED_MODEL=qwen/qwen3-embedding-8b

# Модели для OpenRouter (можно изменить на gemini, claude или др.)
MAIN_MODEL=deepseek/deepseek-v4-flash
REWRITE_MODEL=deepseek/deepseek-v4-flash

# Локальная модель реранкера
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# API ключ для транскрибации голоса (Groq)
GROQ_API_KEY=your_groq_api_key_here

# API ключ Jina для парсинга сайтов и поиска (jina.ai)
JINA_API_KEY=your_jina_api_key_here
